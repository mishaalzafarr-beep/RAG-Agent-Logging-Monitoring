    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nconst today = now.toISOString().split(\"T\")[0];\n\nconst oneHourAgo = new Date(now.getTime() - 60 * 60 * 1000);\n\nlet totalTokensToday = 0;\nlet errorCountLastHour = 0;\n\nfor (const item of items) {\n\n  const row = item.json;\n\n  const timestamp = new Date(row.Timestamp);\n  if (!row.Timestamp) continue;\n\nif (isNaN(timestamp)) continue;\n  // Today's token usage\n  if (timestamp.toISOString().startsWith(today)) {\n    totalTokensToday += Number(row.TotalTokens || 0);\n  }\n\n  // Errors in last hour\n  if (\n    row.Status === \"error\" &&\n    timestamp >= oneHourAgo\n  ) {\n    errorCountLastHour++;\n  }\n\n}\n\nreturn [\n  {\n    json: {\n      totalTokensToday,\n      errorCountLastHour\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        16
      ],
      "id": "ad161a1a-6cff-4b21-904b-f5c8bc43015e",
      "name": "Calculate Metrics"
